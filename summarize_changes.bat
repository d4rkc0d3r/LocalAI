@echo off
setlocal enabledelayedexpansion

:: Resolve script directory (works regardless of how the script is invoked)
set "SCRIPT_DIR=%~dp0"
set "SERVER_URL=http://127.0.0.1:8000"
set "MODEL=Qwen3.8-27B-medium"
set "WORKFLOW_DIR=%SCRIPT_DIR%pending_changes"
set "OUTPUT_FILE=%SCRIPT_DIR%changes_summary.md"

:: Files to append to the request, in order
:: (F1 is generated by fetch_changes.bat in step 1, so only pre-check F2-F4)
set "F1=%WORKFLOW_DIR%\changes_raw_commits.md"
set "F2=%SCRIPT_DIR%README.md"
set "F3=%SCRIPT_DIR%LaunchServer.bat"
set "F4=%SCRIPT_DIR%models.ini"

for %%f in ("%F2%" "%F3%" "%F4%") do if not exist "%%f" (
    echo ERROR: missing file %%f
    exit /b 1
)

echo Server : %SERVER_URL%
echo Model  : %MODEL%
echo Output : %OUTPUT_FILE%
echo.

echo Step 1/3: Fetching upstream changes (pending_changes\fetch_changes.bat)...
call "%WORKFLOW_DIR%\fetch_changes.bat"
echo.

echo Step 2/3: Building request and querying the server...
python "%WORKFLOW_DIR%\summarize_changes.py" --server-url "%SERVER_URL%" --model "%MODEL%" --output "%OUTPUT_FILE%" --dir "%WORKFLOW_DIR%"

if errorlevel 1 (
    echo ERROR: request failed. Is the server running with the %MODEL% model loaded?
    exit /b 1
)

echo Step 3/3: Done.
endlocal
